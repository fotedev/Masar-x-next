public-hoist-pattern[]=*next-intl*
public-hoist-pattern[]=*sentry*
node-linker=hoisted
# `pnpm.neverBuiltDependencies` is configured in the root
# `package.json` under the `pnpm` key, NOT here. pnpm 9.x has a
# known bug where the `.npmrc` form is silently ignored for
# workspace projects (see pnpm/pnpm#5407), so the setting must
# live in the same directory as `pnpm-workspace.yaml`.
#
# Why we need it: better-sqlite3's install script is
# `prebuild-install || node-gyp rebuild --release`. The
# windows-latest runner has no prebuilt binary for Node 24.19.0
# (ABI 137) and only ships Visual Studio 18 (preview), which
# node-gyp cannot detect. Skipping the postinstall here lets
# `electron-builder install-app-deps` fetch the correct
# `electron-v128` prebuild instead.
