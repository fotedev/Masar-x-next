{
  "name": "masarx-monorepo",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "Masar X monorepo — web, desktop, mobile, and shared package",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:desktop": "pnpm --filter desktop dev",
    "dev:mobile": "pnpm --filter mobile dev",
    "build": "pnpm --filter web build",
    "build:web": "pnpm --filter web build",
    "build:desktop": "pnpm --filter desktop build",
    "build:mobile": "pnpm --filter mobile export",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "seed:launch": "node scripts/seed-mvp-launch.mjs",
    "types:generate": "supabase gen types typescript --linked > packages/shared/src/types/database.generated.ts"
  },
  "devDependencies": {
    "fallow": "3.37.0"
  },
  "dependencies": {
    "pg": "^8.18.0"
  },
  "pnpm": {
    "overrides": {
      "send": "0.19.2",
      "postcss": "8.5.32",
      "ajv": "8.20.0",
      "decode-uri-component": "0.5.1",
      "@xmldom/xmldom": "0.8.15",
      "node-forge": "1.4.1",
      "joi": "17.13.9"
    }
  }
}
