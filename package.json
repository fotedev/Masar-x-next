{
  "name": "masarx-monorepo",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "Masar X monorepo — web, desktop, mobile, and shared package",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:desktop": "pnpm --filter desktop dev",
    "dev:mobile": "pnpm --filter mobile dev",
    "build": "pnpm --filter web build",
    "build:web": "pnpm --filter web build",
    "build:desktop": "pnpm --filter desktop build",
    "build:mobile": "pnpm --filter mobile export",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter web test:e2e",
    "seed:launch": "node scripts/seed-mvp-launch.mjs",
    "types:generate": "supabase gen types typescript --linked > packages/shared/src/types/database.generated.ts"
  },
  "devDependencies": {
    "fallow": "3.43.1"
  },
  "dependencies": {
    "pg": "^8.18.0"
  },
  "pnpm": {
    "overrides": {
      "send": "0.19.2",
      "postcss": "8.5.32",
      "ajv@8.11.0": "8.20.0",
      "decode-uri-component": "0.5.1",
      "@xmldom/xmldom": "0.8.15",
      "node-forge": "1.4.3",
      "joi": "17.13.9",
      "tar": "7.5.21",
      "uuid": "11.1.1",
      "fast-xml-parser": "5.12.0",
      "postal-mime": "4.0.8",
      "hono@4.13.14": "4.13.16",
      "@hono/node-server@2.1.5": "2.1.6",
      "undici@7.30.0": "7.30.2",
      "zod-validation-error@2.1.0": "4.0.2",
      "zod@3.25.76": "4.6.7",
      "minimatch@9.0.9": "11.0.1",
      "minimatch@10.2.6": "11.0.1",
      "glob@10.5.0": "14.0.2",
      "glob@11.1.0": "14.0.2",
      "app-builder-lib@25.1.8": "26.18.0",
      "builder-util-runtime@9.2.10": "9.7.0"
    }
  }
}
