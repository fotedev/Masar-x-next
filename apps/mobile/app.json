{
  "expo": {
    "name": "Masar X",
    "slug": "masarx",
    "version": "0.7.0",
    "orientation": "portrait",
    "scheme": "masarx",
    "userInterfaceStyle": "automatic",
    "supportsRTL": true,
    "platforms": [
      "ios",
      "android"
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.masarx.app",
      "supportsTablet": false,
      "infoPlist": {}
    },
    "android": {
      "package": "com.masarx.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "aa63101e-7933-40e9-9e57-2cf928b1e3e4"
      },
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "webOrigin": "https://masarx.vercel.app"
    },
    "owner": "fotexpo"
  }
}
