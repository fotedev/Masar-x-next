{
  "name": "desktop",
  "version": "0.5.7",
  "author": "Masar X",
  "private": true,
  "type": "module",
  "main": "dist/apps/desktop/src/main/index.js",
  "description": "Masar X — An integrated educational platform for university students.",
  "scripts": {
    "dev": "echo '[desktop] dev script not yet implemented — will be wired in US1 (Phase 3). See specs/004-multi-platform-expansion/tasks.md.' && exit 1",
    "prebuild": "node scripts/prebuild.mjs",
    "prebuild:installer": "node scripts/prebuild.mjs",
    "prebuild:portable": "node scripts/prebuild.mjs",
    "prebuild:all": "node scripts/prebuild.mjs",
    "build": "tsc -p tsconfig.build.json && electron-builder --win --x64 --publish never",
    "build:installer": "tsc -p tsconfig.build.json && electron-builder --win nsis --x64 --publish never",
    "build:portable": "tsc -p tsconfig.build.json && electron-builder --win portable --x64 --publish never",
    "build:all": "tsc -p tsconfig.build.json && electron-builder --win --x64 --publish never",
    "typecheck": "tsc --noEmit",
    "lint": "echo '[desktop] no ESLint config yet — scaffold only (T002).'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "electron-updater": "^6.3.9",
    "masarx-shared": "workspace:*",
    "next": "^16.2.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.8",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.5.3",
    "vitest": "^2.1.8"
  }
}
