graph TD
    subgraph "الجهاز المحلي (جهازك)"
        PC[الكمبيوتر الشخصي]
        subgraph "Docker"
            ShadowDB[قاعدة بيانات وهمية - Shadow DB]
            Container[حاوية Supabase]
        end
        Migrations[ملفات الميجريشن - migrations/*.sql]
    end

    subgraph "السحابة (Online)"
