graph TD
    subgraph "Local machine (your computer)"
        PC[Personal computer]
        subgraph "Docker"
            ShadowDB[Shadow database - Shadow DB]
            Container[Supabase container]
        end
        Migrations[Migration files - migrations/*.sql]
    end

    subgraph "Cloud (online)"
        RemoteDB[Real Supabase database]
    end

    PC -->|supabase db pull| ShadowDB
    Migrations -->|compare| ShadowDB
    RemoteDB -->|fetch structure| ShadowDB
    ShadowDB -->|generate diff| PC

    style PC fill:#f9f,stroke:#333,stroke-width:2px
    style Docker fill:#0db7ed,stroke:#fff,stroke-width:2px
    style RemoteDB fill:#3ecf8e,stroke:#fff,stroke-width:2px
