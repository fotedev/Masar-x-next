flowchart TD

%% --- ACTORS ---
User["Users (المستخدمين)"]
RA(["Root Admin (مدير النظام)"])

%% --- CLIENT LAYER (NEXT.JS) ---
subgraph ClientApp ["Next.js App Layer (واجهة المستخدم)"]
    direction TB
    I18n{"I18n Middleware<br/>Detect Locale"}
    
    subgraph PublicRoutes ["Public (عام)"]
        Home["/ (Home - الرئيسية)"]
        News["/news (الأخبار)"]
    end

    subgraph ProtectedRoutes ["Authenticated (محمي)"]
        direction TB
        Profile["/profile (الملف الشخصي)"]
        
        subgraph AcademicHub ["Academic Hub (المحور الأكاديمي)"]
            Subjects["/subjects (المواد)"]
            Courses["/courses (الدورات)"]
            Quizzes["/quizzes (الاختبارات)"]
        end
        
        AI_Assist["/ai-assistant (المساعد الذكي)"]
        TRW["/trw (Premium Studies)"]
        
        subgraph AdminPortal ["Admin Dashboard (لوحة التحكم)"]
            Moderation["/admin/moderation"]
            Settings["/admin/settings"]
        end
    end
end

%% --- API / INTERMEDIATE LAYER ---
Auth_Middleware{{"App Router Middleware<br/>(Auth Check)"}}

%% --- BACKEND SERVICES LAYER (SUPABASE) ---
subgraph SupabaseLayer ["Supabase Platform (منصة الخدمات الخلفية)"]
    direction TB
    
    Auth_Service["Supabase Auth<br/>(JWT, RLS)"]
    EF_Gateway["Supabase Edge Functions Gateway"]
    
    subgraph EdgeFunctions ["Edge Functions (وظائف الحافة)"]
        direction LR
        Func_PDF["process-pdf"]
        Func_Upload["upload-file"]
        Func_Email["auth-hook-email"]
        Func_Chat["summarize-chat"]
    end
    
    DB_Gateway["PostgreSQL Gateway"]
end

%% --- DATA STORAGE LAYER ---
subgraph StorageLayer ["Data & Assets (البيانات والوسائط)"]
    direction TB
    
    SupaStorage[("Supabase Storage<br/>Avatars, TempFiles")]
    
    subgraph PostgreSQL ["PostgreSQL Schema (قاعدة البيانات)"]
        direction TB
        
        subgraph Schema_Identity ["Identity & Roles"]
            profiles["profiles (id, full_name, role, department_id)"]
            admins["admins (user_id, role, permissions)"]
        end

        subgraph Schema_Academic ["Academic Structure"]
            levels["academic_levels (id, level_number, name)"]
            departments["departments (id, name, level_id)"]
            subjects_db["subjects (id, name, semester, department_id)"]
            lectures["subject_lectures (id, subject_id, lecture_key)"]
        end

        subgraph Schema_Content ["Content & Interactivity"]
            summaries["summaries (id, subject_id, user_id, status)"]
            videos["videos (id, lecture_id, url)"]
            quizzes_db["quizzes (id, subject_id, course_id)"]
            reviews["reviews (id, user_id, video_id, rating)"]
        end
        
        PlatformSettings[("platform_settings")]
    end
end

%% --- EXTERNAL APIS ---
subgraph ExternalAPIs ["External APIs (خدمات خارجية)"]
    direction TB
    CDN_Cloudinary(("Cloudinary<br/>Media Assets"))
    SMTP_Brevo(("Brevo<br/>Transactional Email"))
    AI_Gemini(("Google Gemini<br/>LLM Integration"))
end

%% --- RELATIONSHIPS & DATA FLOW ---

%% 1. User Interaction
User --> I18n
RA --> Moderation

%% 2. Frontend Routing & Protection
I18n --> Auth_Middleware
Auth_Middleware --> PublicRoutes
Auth_Middleware -- "Valid Session" --> ProtectedRoutes
Auth_Middleware -- "No Session" --> Home
Auth_Middleware -- "Admin Role" --> AdminPortal

%% 3. Frontend to Backend Services
ProtectedRoutes --> Auth_Service
AcademicHub --> DB_Gateway
AI_Assist --> Func_Chat
Profile --> Func_Upload

%% 4. Backend Services Interaction
Auth_Service -.-> profiles
DB_Gateway --> PostgreSQL
EF_Gateway --> EdgeFunctions

%% 5. Edge Function Flows
Func_PDF --> DB_Gateway
Func_PDF --> CDN_Cloudinary
Func_Upload --> SupaStorage
Func_Email --> SMTP_Brevo
Func_Chat --> AI_Gemini

%% 6. Database Internals
profiles --> admins
levels --> departments
departments --> subjects_db
subjects_db --> lectures
PlatformSettings -.-> ProtectedRoutes

