classDef client fill:#0f172a,stroke:#3b82f6,color:#bfdbfe;
classDef service fill:#1e1b4b,stroke:#8b5cf6,color:#ddd6fe;
classDef db fill:#020617,stroke:#10b981,color:#d1fae5;
classDef storage fill:#111827,stroke:#10b981,stroke-dasharray: 3 3,color:#d1fae5;
classDef external fill:#1c1917,stroke:#f59e0b,color:#fef3c7,stroke-dasharray: 5 5;

%% Apply classes
class User,RA user;
class AdminPortal,admins,Moderation,Settings,RA admin;
class ClientApp,PublicRoutes,ProtectedRoutes,Home,News,Profile,AcademicHub,Subjects,Courses,Quizzes,AI_Assist,TRW,Auth_Middleware,I18n client;
class SupabaseLayer,Auth_Service,EF_Gateway,EdgeFunctions,Func_PDF,Func_Upload,Func_Email,Func_Chat,DB_Gateway service;
class PostgreSQL,Schema_Identity,Schema_Academic,Schema_Content,PlatformSettings,profiles,levels,departments,subjects_db,lectures,summaries,videos,quizzes_db,reviews,PostgreSQL,SupaStorage db;
class CDN_Cloudinary,SMTP_Brevo,AI_Gemini external;

%% --- NOTES ---
%% 1. i18n Detection: Middleware uses request path for reliable language context.
%% 2. Gated Access: 'admins' table dictates access to Moderation paths.
%% 3. Edge Compute: PDF processing, email hooks, and AI logic are offloaded to V8 Edge Functions.
%% 4. Hybrid Media: Avatars use internal storage; academic media uses external CDN (Cloudinary).