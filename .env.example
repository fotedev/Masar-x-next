# =============================================================================
# MasarX — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local (or any file containing real secrets) to git.
#
#   cp .env.example .env.local
#
# Variables prefixed with NEXT_PUBLIC_ are bundled into the client-side JS
# and are visible to every browser. Keep secrets out of NEXT_PUBLIC_ vars.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase (required)
# -----------------------------------------------------------------------------
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Direct connection string — used by Drizzle / admin-db (server-side only).
# Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Session Pooler URI — required on IPv4-only hosts (e.g. WSL2 on Windows).
# The direct host above (db.*.supabase.co) is IPv6-only and will fail with
# ENETUNREACH on IPv4-only networks. Use the Session Pooler (port 5432) instead:
# Supabase Dashboard → Settings → Database → Connection Pooling → URI
# DATABASE_URL_IPV4=postgresql://postgres.your-project-ref:password@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: override the DB host/port derived from DATABASE_URL / DATABASE_URL_IPV4.
# Useful when tunnelling or using a local proxy. Leave commented unless needed.
# DATABASE_HOST=db.your-project-ref.supabase.co
# DATABASE_PORT=5432


# -----------------------------------------------------------------------------
# Cloudinary — file & image uploads
# -----------------------------------------------------------------------------
# Find these in: Cloudinary Dashboard → Settings → Upload
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# Create an unsigned upload preset in Cloudinary → Settings → Upload → Upload Presets
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset


# -----------------------------------------------------------------------------
# Google Analytics (optional)
# -----------------------------------------------------------------------------
# Leave blank or remove to disable GA tracking.
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX


# -----------------------------------------------------------------------------
# App — public site configuration
# -----------------------------------------------------------------------------
# Full URL of the deployed site, used for OG tags, sitemaps, canonical URLs, etc.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Display name of the university / institution shown in the UI.
# Falls back to the hardcoded default ("جامعة مسار") when not set.
NEXT_PUBLIC_COLLEGE_NAME=اسم الجامعة


# -----------------------------------------------------------------------------
# Vercel MCP integration (optional)
# -----------------------------------------------------------------------------
# Secret used to authenticate requests to the /api/mcp route.
# Set this to a long random string; keep it out of NEXT_PUBLIC_ vars.
# Generate one with: openssl rand -hex 32
VERCEL_MCP_BYPASS_SECRET=your-secret-here


# -----------------------------------------------------------------------------
# Build tooling
# -----------------------------------------------------------------------------
# Set to "true" to enable the Next.js bundle analyser (`pnpm analyze`).
# Should always be "false" in production / CI environments.
ANALYZE=false
# -----------------------------------------------------------------------------
# Upstash Redis (optional) - durable rate limiting (T006)
# -----------------------------------------------------------------------------
# REST URL of the Upstash Redis instance used for cross-instance rate limiting.
UPSTASH_REDIS_REST_URL=
# REST token for the Upstash Redis instance (secret; server-side only).
UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Sentry (optional) - error monitoring (T016)
# -----------------------------------------------------------------------------
# Ingest DSN for Sentry error reporting; leave blank to disable.
SENTRY_DSN=

# --- Spec-driven additions (2026-08-31) ---
# Canonical app origin used for CORS scoping and absolute URLs.
NEXT_PUBLIC_APP_URL=
